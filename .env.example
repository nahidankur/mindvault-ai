# ==========================================
# MindVault AI Environment Configuration
# ==========================================

# 1. Database (PostgreSQL with pgvector)
# Local Docker or Neon Cloud
DATABASE_URL=postgresql://mindvault:mindvault_password@localhost:5432/mindvault_db?sslmode=disable

# 2. Redis Configuration (for BullMQ)
# Local Docker or Aiven / Upstash
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# 3. Backend API Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# 4. Authentication (JWT)
JWT_SECRET=mindvault_dev_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=mindvault_dev_super_secret_refresh_jwt_key
JWT_REFRESH_EXPIRES_IN=30d

# 5. AI Providers (Google Gemini API - Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# 6. Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="MindVault AI"
